[sub_resource type="GDScript" id="GDScript_5y8l3"]
resource_name = "enemy1 life"
script/source = "extends TextureProgressBar

@export var max_health: float = 300.0
var current_health: float
@onready var enemy: CharacterBody2D = get_parent()

func _ready() -> void:
	if enemy:
		max_value = enemy.max_health
		value = enemy.current_health
		# Conecta o sinal do inimigo
		enemy.health_changed.connect(update_bar)

func update_bar(new_health: float) -> void:
	value = new_health
signal health_changed(new_health)
signal died


func take_damage(amount: float) -> void:
	current_health -= amount
	current_health = max(0, current_health) # Impede que o HP fique menor que 0
	health_changed.emit(current_health)
	
	if current_health <= 0:
		die()

func die() -> void:
	died.emit()
	queue_free() # Destrói o inimigo
"

