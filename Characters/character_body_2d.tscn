[sub_resource type="GDScript" id="GDScript_anxv6"]
resource_name = "life"
script/source = "extends TextureProgressBar


@export var max_health: float = 100.0
@export var regen_rate: float = 1.0   # Vida recuperada por segundo
@export var regen_delay: float = 3.0  # Tempo em segundos sem tomar dano para iniciar a regeneração
func _on_attack_area_body_entered(body: Node2D) -> void:
	if body.has_method(\"take_damage\"):
		body.take_damage(5.0) # Quantidade de dano provocada
var current_health: float
var time_since_last_hit: float = 0.0

signal health_changed(new_health)
signal died

func _ready() -> void:
	current_health = max_health

func _process(delta: float) -> void:
	time_since_last_hit += delta

	# Regenera se o tempo de espera passou e o HP ainda não atingiu o máximo
	if time_since_last_hit >= regen_delay and current_health < max_health:
		current_health = min(max_health, current_health + (regen_rate * delta))
		health_changed.emit(current_health)

func take_damage(amount: float) -> void:
	current_health -= amount
	time_since_last_hit = 0.0  # Reinicia o contador ao receber dano
	health_changed.emit(current_health)
	
	if current_health <= 0:
		die()

func die() -> void:
	died.emit()
	queue_free()
	
"

